#include <stdio.h>
#include <string.h>

int main()
{
    char file[10][20], name[20];
    int n, i, found = 0;

    printf("Enter number of files: ");
    scanf("%d", &n);

    printf("Enter file names:\n");
    for(i = 0; i < n; i++)
        scanf("%19s", file[i]);

    printf("Enter file to search: ");
    scanf("%19s", name);

    for(i = 0; i < n; i++)
    {
        if(strcmp(file[i], name) == 0)
        {
            found = 1;
            break;
        }
    }

    if(found)
        printf("File found");
    else
        printf("File not found");

    return 0;
}
