#include <stdio.h>

int main() {
    int n, i, j, bt[10], p[10], id[10], temp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        id[i] = i + 1;
        printf("Enter burst time and priority: ");
        scanf("%d %d", &bt[i], &p[i]);
    }

    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (p[i] > p[j]) {
                temp = p[i]; p[i] = p[j]; p[j] = temp;
                temp = bt[i]; bt[i] = bt[j]; bt[j] = temp;
                temp = id[i]; id[i] = id[j]; id[j] = temp;
            }
        }
    }

    printf("Execution order: ");
    for (i = 0; i < n; i++)
        printf("P%d ", id[i]);

    return 0;
}
