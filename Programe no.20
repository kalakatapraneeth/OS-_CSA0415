#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t mutex, write;
int readers = 0;

void *reader(void *arg)
{
    sem_wait(&mutex);
    readers++;
    if (readers == 1)
        sem_wait(&write);
    sem_post(&mutex);

    printf("Reader is reading\n");

    sem_wait(&mutex);
    readers--;
    if (readers == 0)
        sem_post(&write);
    sem_post(&mutex);

    return NULL;
}

void *writer(void *arg)
{
    sem_wait(&write);
    printf("Writer is writing\n");
    sem_post(&write);

    return NULL;
}

int main()
{
    pthread_t r, w;

    sem_init(&mutex, 0, 1);
    sem_init(&write, 0, 1);

    pthread_create(&r, NULL, reader, NULL);
    pthread_create(&w, NULL, writer, NULL);

    pthread_join(r, NULL);
    pthread_join(w, NULL);

    sem_destroy(&mutex);
    sem_destroy(&write);

    return 0;
}
