#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat st;
    DIR *d;
    struct dirent *de;

    fd = open("test.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Hello UNIX", 10);

    fcntl(fd, F_GETFD);

    lseek(fd, 0, SEEK_SET);

    stat("test.txt", &st);
    printf("File Size: %ld\n", (long)st.st_size);

    close(fd);

    d = opendir(".");

    printf("Directory Files:\n");
    while((de = readdir(d)) != NULL)
        printf("%s\n", de->d_name);

    closedir(d);

    return 0;
}
